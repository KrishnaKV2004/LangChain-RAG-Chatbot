# ===========================================================================
# Hybrid RAG AI Agent — environment configuration
# Copy to `.env` and fill in your keys. Nested settings use `__` delimiter.
# Every value below (except API keys) is optional — defaults are sensible.
# ===========================================================================

# ---- Required API keys -----------------------------------------------------
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# ---- Optional provider keys ------------------------------------------------
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
# COHERE_API_KEY=

# ---- Environment -----------------------------------------------------------
ENVIRONMENT=development            # development | staging | production

# ---- LLM -------------------------------------------------------------------
LLM__PROVIDER=openai               # openai | anthropic
LLM__MODEL=gpt-4o
LLM__ROUTER_MODEL=gpt-4o-mini      # cheap model for query classification
LLM__TEMPERATURE=0.1
LLM__MAX_TOKENS=1024
# Any OpenAI-compatible endpoint (makes OPENAI_API_KEY optional for local ones):
#   Ollama:     LLM__BASE_URL=http://localhost:11434/v1   LLM__MODEL=llama3.2
#   Groq:       LLM__BASE_URL=https://api.groq.com/openai/v1  OPENAI_API_KEY=gsk_...
#   LM Studio:  LLM__BASE_URL=http://localhost:1234/v1
# LLM__BASE_URL=

# ---- Embeddings ------------------------------------------------------------
EMBEDDING__PROVIDER=openai         # openai | voyage | cohere | sentence_transformers
# EMBEDDING__MODEL=                # blank = provider's recommended default
# Free local test mode (no API cost, runs on-device):
# EMBEDDING__PROVIDER=sentence_transformers

# ---- Chunking --------------------------------------------------------------
CHUNKING__CHUNK_SIZE=1000
CHUNKING__CHUNK_OVERLAP=200

# ---- Retrieval -------------------------------------------------------------
RETRIEVAL__SEARCH_TYPE=mmr         # similarity | mmr
RETRIEVAL__TOP_K=5
RETRIEVAL__FETCH_K=20
RETRIEVAL__SCORE_THRESHOLD=0.30
RETRIEVAL__RERANK_ENABLED=true

# ---- Vector store ----------------------------------------------------------
VECTOR_STORE__PERSIST_DIRECTORY=data/chroma

# ---- Web search ------------------------------------------------------------
WEB_SEARCH__PROVIDER=tavily
WEB_SEARCH__MAX_RESULTS=5
WEB_SEARCH__CACHE_TTL_SECONDS=86400   # 24 h

# ---- Cache -----------------------------------------------------------------
CACHE__PATH=data/cache

# ---- Hermes (self-refinement agent) -----------------------------------------
HERMES__ENABLED=true               # review + improve every draft answer
HERMES__MAX_ITERATIONS=2           # review passes per answer (1-3)

# ---- Security --------------------------------------------------------------
SECURITY__PROMPT_INJECTION_DETECTION=true
SECURITY__SENSITIVE_DOCUMENT_DETECTION=true
SECURITY__PERMISSION_VALIDATION=true
SECURITY__RESPONSE_SCANNING=true
SECURITY__PII_DETECTION=true

# ---- API server ------------------------------------------------------------
API__HOST=0.0.0.0
API__PORT=8000
# API__AUTH_TOKEN=                 # set to require Bearer auth on all endpoints

# ---- Logging ---------------------------------------------------------------
LOGGING__LEVEL=INFO
LOGGING__JSON_FORMAT=false         # true = JSON lines for log aggregators
