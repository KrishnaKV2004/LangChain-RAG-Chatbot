# ===========================================================================
# Hybrid RAG AI Agent — environment configuration
# Copy to `.env` and fill in your keys. Nested settings use `__` delimiter.
# Every value below (except API keys) is optional — defaults are sensible.
# ===========================================================================

# ---- Required API keys -----------------------------------------------------

OPENAI_API_KEY="Your Model API Key Here"
TAVILY_API_KEY="Your Tavily Key Here"

# ---- Environment -----------------------------------------------------------

ENVIRONMENT=development            # development | staging | production

# ---- LLM -------------------------------------------------------------------

LLM__PROVIDER=openai               # openai | anthropic
LLM__MODEL=gpt-4o
LLM__ROUTER_MODEL=gpt-4o-mini      # cheap model for query classification
# Any OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, LM Studio, vLLM).
# REQUIRED if you point at a proxy rather than api.openai.com.
# LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__TEMPERATURE=0.1
LLM__MAX_TOKENS=1024

# ---- Embeddings ------------------------------------------------------------

EMBEDDING__PROVIDER=openai         # openai | voyage | cohere | sentence_transformers
# EMBEDDING__MODEL=                # blank = provider's recommended default

# ---- Chunking --------------------------------------------------------------

CHUNKING__CHUNK_SIZE=1000
CHUNKING__CHUNK_OVERLAP=200

# ---- Retrieval -------------------------------------------------------------

RETRIEVAL__SEARCH_TYPE=mmr         # similarity | mmr
RETRIEVAL__TOP_K=5
RETRIEVAL__FETCH_K=20
RETRIEVAL__SCORE_THRESHOLD=0.30
RETRIEVAL__RERANK_ENABLED=true

# ---- Vector store ----------------------------------------------------------

VECTOR_STORE__PERSIST_DIRECTORY=data/chroma

# ---- Web search ------------------------------------------------------------

WEB_SEARCH__PROVIDER=tavily
WEB_SEARCH__MAX_RESULTS=3
WEB_SEARCH__CACHE_TTL_SECONDS=86400   # 24 h

# ---- Freight rates (7LFreight) ---------------------------------------------
# Enables the RATES route + POST /rates (live air / LTL / ocean quotes).
# 7LFreight authenticates with a username/password (NOT a static API key) to
# mint a JWT; leave these unset to disable rate quoting entirely.

7L_USERNAME="Your 7LFreight Username"
7L_PASSWORD="Your 7LFreight Password"
RATES__ENABLED=true
RATES__BASE_URL=https://restapi.my7l.com
RATES__CACHE_TTL_SECONDS=300          # 5 min — quotes carry their own validity
RATES__MAX_CARRIERS_RETURNED=5

# ---- MyCarrier (truck legs: warehouse <-> airport) --------------------------
# No API key: the account is identified by these fields in the request body.

MYCARRIER__ENABLED=true
MYCARRIER__CUSTOMER_NAME="Your MyCarrier Customer Name"
MYCARRIER__CUSTOMER_EMAIL="your.account@example.com"
MYCARRIER__LOCATION_ID="0000000"
MYCARRIER__WAREHOUSE_CSV=documents/Warehouses.csv

# ---- Cache -----------------------------------------------------------------

CACHE__PATH=data/cache

# ---- Security --------------------------------------------------------------
SECURITY__PROMPT_INJECTION_DETECTION=true
SECURITY__SENSITIVE_DOCUMENT_DETECTION=true
SECURITY__PERMISSION_VALIDATION=true
SECURITY__RESPONSE_SCANNING=true
SECURITY__PII_DETECTION=true

# ---- API server ------------------------------------------------------------

API__HOST=0.0.0.0
API__PORT=8000
# API__AUTH_TOKEN=                 # set to require Bearer auth on all endpoints

# ---- Logging ---------------------------------------------------------------

LOGGING__LEVEL=INFO
LOGGING__JSON_FORMAT=false         # true = JSON lines for log aggregators
